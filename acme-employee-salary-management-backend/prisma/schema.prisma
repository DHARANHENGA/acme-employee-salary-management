generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Department {
  id        Int        @id @default(autoincrement())
  name      String     @unique @db.VarChar(100)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  employees Employee[]

  @@map("departments")
}

model Currency {
  id           Int           @id @default(autoincrement())
  code         String        @unique @db.VarChar(10)
  name         String        @db.VarChar(100)
  symbol       String        @db.VarChar(10)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  countries    Country[]
  employees    Employee[]
  exchangeRate ExchangeRate?

  @@map("currencies")
}

model Country {
  id         Int        @id @default(autoincrement())
  code       String     @unique @db.VarChar(10)
  name       String     @db.VarChar(100)
  currencyId Int        @map("currency_id")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  currency   Currency   @relation(fields: [currencyId], references: [id])
  employees  Employee[]

  @@map("countries")
}

model ExchangeRate {
  id         Int      @id @default(autoincrement())
  currencyId Int      @unique @map("currency_id")
  rateToUsd  Decimal  @map("rate_to_usd") @db.Decimal(18, 6)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  currency   Currency @relation(fields: [currencyId], references: [id])

  @@map("exchange_rates")
}

model Employee {
  id           Int        @id @default(autoincrement())
  employeeId   String     @unique @db.VarChar(20) @map("employee_id")
  name         String     @db.VarChar(150)
  departmentId Int        @map("department_id")
  jobTitle     String     @db.VarChar(100) @map("job_title")
  countryId    Int        @map("country_id")
  currencyId   Int        @map("currency_id")
  dateJoined   DateTime   @map("date_joined") @db.Date
  baseSalary   Decimal    @map("base_salary") @db.Decimal(18, 2)
  status       String     @default("ACTIVE") @db.VarChar(10)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  department   Department @relation(fields: [departmentId], references: [id])
  country      Country    @relation(fields: [countryId], references: [id])
  currency     Currency   @relation(fields: [currencyId], references: [id])

  @@index([departmentId], name: "idx_employees_department_id")
  @@index([countryId], name: "idx_employees_country_id")
  @@index([currencyId], name: "idx_employees_currency_id")
  @@index([status], name: "idx_employees_status")
  @@map("employees")
}
